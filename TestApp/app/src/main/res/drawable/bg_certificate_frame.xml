<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Background: Light Cream/Paper -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FDFCF0" />
        </shape>
    </item>

    <!-- Outer Double Border (Main Frame) -->
    <!-- Outer Thicker Line -->
    <item android:top="12dp" android:left="12dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#2D5A58" />
        </shape>
    </item>

    <!-- Inner Thin Elegant Line -->
    <item android:top="18dp" android:left="18dp" android:right="18dp" android:bottom="18dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#2D5A58" />
        </shape>
    </item>
</layer-list>