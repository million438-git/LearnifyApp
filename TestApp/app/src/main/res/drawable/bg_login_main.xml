<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base deep black background -->
    <item>
        <shape>
            <solid android:color="#01040D" />
        </shape>
    </item>

    <!-- Top-Center Spotlight (The main blue glow) -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="500dp"
                android:centerX="50%"
                android:centerY="15%"
                android:startColor="#661E90FF"
                android:endColor="#0001040D" />
        </shape>
    </item>

    <!-- Side soft glow to match the image's lighting -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="700dp"
                android:centerX="100%"
                android:centerY="40%"
                android:startColor="#264A90E2"
                android:endColor="#0001040D" />
        </shape>
    </item>
</layer-list>