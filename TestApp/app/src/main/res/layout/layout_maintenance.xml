<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="#FFFFFF">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@android:drawable/ic_menu_manage"
        android:contentDescription="Maintenance" />

    <TextView
        android:id="@+id/tvMaintenanceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="System Maintenance"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvMaintenanceMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="The system is currently undergoing scheduled maintenance. Please try again later."
        android:textSize="16sp"
        android:textColor="#64748B"
        android:gravity="center"
        android:layout_marginTop="16dp" />

</LinearLayout>
