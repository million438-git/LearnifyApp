<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    tools:context=".EditProfileActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        app:elevation="1dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/editProfileToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/text_primary_slate">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="Student Profile"
                    android:textColor="@color/text_primary_slate"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveTop"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Save"
                        android:textAllCaps="false"
                        android:textColor="@color/surface_white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/sapphire_primary"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_verified_check"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="14dp"
                        app:iconTint="@color/surface_white" />

                    <ImageButton
                        android:id="@+id/btnLanguageTop"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Language"
                        android:padding="8dp"
                        android:src="@drawable/ic_globe"
                        app:tint="@color/text_secondary_slate" />
                </LinearLayout>
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <!-- Profile Avatar Hero Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_banner"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="32dp">

                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivEditProfilePic"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#1E293B"
                        android:padding="3dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_user_person"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        app:strokeColor="#FFFFFF"
                        app:strokeWidth="4dp" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnChangePic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:contentDescription="Change Photo"
                        app:backgroundTint="@color/sapphire_primary_light"
                        app:elevation="4dp"
                        app:fabCustomSize="38dp"
                        app:maxImageSize="18dp"
                        app:srcCompat="@android:drawable/ic_menu_camera"
                        app:tint="@color/surface_white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvDisplayFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Student"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDisplayUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="\@student"
                    android:textColor="#93C5FD"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Personal Info -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="Personal Information"
                android:textColor="@color/sapphire_primary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileSectionCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/ProfileInputStyle"
                        android:hint="Full Name">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFullName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/ProfileInputStyle"
                        android:hint="Username">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="false" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/ProfileInputStyle"
                        android:hint="Email Address">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/ProfileInputStyle"
                        android:hint="Phone Number (optional)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Academic Info -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="Academic Background"
                android:textColor="@color/sapphire_primary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileSectionCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/ProfileInputStyle"
                        android:hint="University / Institution">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUniversity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/ProfileInputStyle"
                        android:hint="Academic Year / Level">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etYear"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/ProfileInputStyle"
                        android:hint="Major / Field of Study">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMajor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Learning Preferences -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="Learning Preferences"
                android:textColor="@color/sapphire_primary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileSectionCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active Subjects"
                        android:textColor="@color/text_primary_slate"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupSubjects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mathematics"
                            app:chipBackgroundColor="@color/sapphire_subtle"
                            app:chipStrokeColor="@color/sapphire_primary_light"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Physics"
                            app:chipBackgroundColor="@color/teal_subtle"
                            app:chipStrokeColor="@color/teal_accent_light"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/btnAddSubject"
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ Add Subject"
                            app:chipStrokeColor="@color/card_stroke"
                            app:chipStrokeWidth="1dp" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Daily Target XP Goal"
                        android:textColor="@color/text_primary_slate"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderXP"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:stepSize="100"
                            android:value="500"
                            android:valueFrom="100"
                            android:valueTo="2000"
                            app:thumbColor="@color/sapphire_primary"
                            app:trackColorActive="@color/sapphire_primary"
                            app:trackColorInactive="@color/sapphire_subtle" />

                        <TextView
                            android:id="@+id/tvXPValue"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="500 XP"
                            android:textAlignment="viewEnd"
                            android:textColor="@color/sapphire_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/card_stroke" />

                    <LinearLayout
                        android:id="@+id/llReminderTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Daily study reminder"
                            android:textColor="@color/text_primary_slate"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvReminderTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏰ 5:00 PM"
                            android:textColor="@color/sapphire_primary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- App Language -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="Language Preferences"
                android:textColor="@color/sapphire_primary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileSectionCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout style="@style/ProfileRowStyle">
                        <TextView
                            style="@style/ProfileRowLabel"
                            android:text="Current language" />
                        <TextView
                            android:id="@+id/tvCurrentLanguage"
                            style="@style/ProfileRowValue"
                            android:text="English" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/card_stroke" />

                    <LinearLayout
                        android:id="@+id/llChangeLanguage"
                        style="@style/ProfileRowStyle"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            style="@style/ProfileRowLabel"
                            android:text="Change language" />
                        <TextView
                            style="@style/ProfileRowValue"
                            android:text="Select →"
                            android:textColor="@color/sapphire_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Privacy & Security -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="Privacy &amp; Security Controls"
                android:textColor="@color/sapphire_primary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileSectionCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout style="@style/ProfileRowStyle">
                        <TextView
                            style="@style/ProfileRowLabel"
                            android:text="Profile Visibility" />
                        <TextView
                            android:id="@+id/tvVisibility"
                            style="@style/ProfileRowValue"
                            android:text="Public ▼" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/card_stroke" />

                    <LinearLayout style="@style/ProfileRowStyle">
                        <TextView
                            style="@style/ProfileRowLabel"
                            android:text="Show on Leaderboard" />
                        <TextView
                            android:id="@+id/tvLeaderboard"
                            style="@style/ProfileRowValue"
                            android:text="Yes ▼" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/card_stroke" />

                    <LinearLayout style="@style/ProfileRowStyle">
                        <TextView
                            style="@style/ProfileRowLabel"
                            android:text="Email Notifications" />
                        <TextView
                            android:id="@+id/tvNotifications"
                            style="@style/ProfileRowValue"
                            android:text="On ▼" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/card_stroke" />

                    <LinearLayout
                        android:id="@+id/llChangePassword"
                        style="@style/ProfileRowStyle"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            style="@style/ProfileRowLabel"
                            android:text="Change Password" />
                        <TextView
                            style="@style/ProfileRowValue"
                            android:text="Edit →"
                            android:textColor="@color/sapphire_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Danger Zone -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="Danger Zone"
                android:textColor="@color/rose_accent" />

            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileSectionCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#FECDD3"
                app:strokeWidth="1dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeactivate"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Deactivate Account"
                    android:textAllCaps="false"
                    android:textColor="@color/rose_accent"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_trash"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/rose_accent" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
