<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/forgotScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/learnify_void_navy"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ForgotPasswordActivity"
    tools:theme="@style/Theme.TestApp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Responsive container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="520dp"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="48dp">

            <!-- ===================================================== -->
            <!-- SECTION A: Header with Back & Brand Identity          -->
            <!-- ===================================================== -->
            <RelativeLayout
                android:id="@+id/forgotHeaderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Back Navigation Button -->
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Back"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_back_white" />

                <!-- Centered Brand Identity -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="Learnify Logo"
                        android:src="@drawable/ic_learnify_brand_logo" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Learnify"
                            android:textColor="@color/learnify_ice_white"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.14"
                            android:text="INTELLIGENCE MEETS CURIOSITY"
                            android:textColor="@color/learnify_neon_cyan"
                            android:textSize="8sp" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>

            <!-- ===================================================== -->
            <!-- SECTION B: Recovery Hero Artwork & Heading            -->
            <!-- ===================================================== -->
            <LinearLayout
                android:id="@+id/forgotHeroContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Subtle Cyan Recovery / Mail Illustration -->
                <ImageView
                    android:id="@+id/ivRecoveryHero"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="Recovery Illustration"
                    android:src="@drawable/ic_recovery_mail_hero" />

                <!-- Main Title -->
                <TextView
                    android:id="@+id/forgotTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="Let's get you back in."
                    android:textColor="@color/learnify_ice_white"
                    android:textSize="26sp" />

                <!-- Supporting Text -->
                <TextView
                    android:id="@+id/forgotSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Forgot your password? We'll help you recover access to your Learnify account."
                    android:textColor="@color/learnify_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ===================================================== -->
            <!-- STEP 1: Registered Email Address & Send Instructions  -->
            <!-- ===================================================== -->
            <LinearLayout
                android:id="@+id/llStepEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <!-- Registered Email Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Registered email address"
                    android:textColor="@color/learnify_ice_white"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilResetEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/resetEmail"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_field_dark"
                        android:drawableStart="@drawable/ic_email_mail"
                        android:drawablePadding="14dp"
                        android:drawableTint="@color/learnify_text_secondary"
                        android:fontFamily="sans-serif"
                        android:hint="Enter your registered email"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/learnify_ice_white"
                        android:textColorHint="@color/learnify_text_muted"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Primary Action Button: SEND RESET INSTRUCTIONS -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerifyEmail"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_btn_primary_cyan"
                        android:elevation="4dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.08"
                        android:text="SEND RESET INSTRUCTIONS"
                        android:textAllCaps="false"
                        android:textColor="@color/learnify_void_navy"
                        android:textSize="15sp"
                        app:backgroundTint="@null"
                        app:cornerRadius="14dp" />

                    <!-- Loading Indicator -->
                    <ProgressBar
                        android:id="@+id/resetProgressBar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/learnify_void_navy"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Security Information Panel (Section E) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_security_banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="Security Shield"
                        android:src="@drawable/ic_shield_security"
                        app:tint="@color/learnify_science_mint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-semibold"
                            android:text="Secure recovery"
                            android:textColor="@color/learnify_ice_white"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="Firebase will email a secure password-reset link. Use that link to choose a new password."
                            android:textColor="@color/learnify_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===================================================== -->
            <!-- STEP 2: Firebase Reset Link Instructions              -->
            <!-- ===================================================== -->
            <LinearLayout
                android:id="@+id/llStepReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Reset link instructions -->
                <TextView
                    android:id="@+id/tvResetInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="Open the secure password-reset link Firebase sent to your email. After choosing a new password, return here and sign in."
                    android:textColor="@color/learnify_text_secondary"
                    android:textSize="13sp" />

                <!-- Update Password Button -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpdatePassword"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_btn_primary_cyan"
                        android:elevation="4dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.08"
                        android:text="RETURN TO SIGN IN"
                        android:textAllCaps="false"
                        android:textColor="@color/learnify_void_navy"
                        android:textSize="15sp"
                        app:backgroundTint="@null"
                        app:cornerRadius="14dp" />

                </FrameLayout>

                <!-- Resend Reset Link & Change Email Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvResendCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:padding="8dp"
                        android:text="Resend Reset Link"
                        android:textColor="@color/learnify_neon_cyan"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:text="•"
                        android:textColor="@color/learnify_text_muted" />

                    <TextView
                        android:id="@+id/tvChangeEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif"
                        android:padding="8dp"
                        android:text="Use Different Email"
                        android:textColor="@color/learnify_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================================================== -->
            <!-- SECTION F: Return Navigation (Back to Sign In)        -->
            <!-- ===================================================== -->
            <TextView
                android:id="@+id/backToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:padding="10dp"
                android:text="Back to Sign In"
                android:textColor="@color/learnify_neon_cyan"
                android:textSize="14sp" />

            <!-- Branded Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.04"
                android:text="Learnify Academic Ecosystem • Grade 9–12"
                android:textColor="@color/learnify_text_muted"
                android:textSize="11sp" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>