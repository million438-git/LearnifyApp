<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_light">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/text_primary_slate"
            app:title="Camera Settings"
            app:titleCentered="true"
            app:titleTextColor="@color/text_primary_slate" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="AI SCANNER PREFERENCES" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Auto Detect -->
                    <LinearLayout
                        style="@style/SettingsItem">
                        <ImageView
                            style="@style/SettingsItemIcon"
                            android:src="@drawable/ic_real_camera" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/SettingsItemText"
                                android:layout_width="match_parent"
                                android:layout_weight="0"
                                android:text="Auto-detect problems" />
                            <TextView
                                style="@style/SettingsItemDescription"
                                android:text="Trigger OCR on steady text framing" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAutoDetect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <!-- Grid Lines -->
                    <LinearLayout
                        style="@style/SettingsItem">
                        <ImageView
                            style="@style/SettingsItemIcon"
                            android:src="@drawable/ic_grid" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/SettingsItemText"
                                android:layout_width="match_parent"
                                android:layout_weight="0"
                                android:text="Show Grid Lines" />
                            <TextView
                                style="@style/SettingsItemDescription"
                                android:text="Rule-of-thirds viewfinder alignment" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchGrid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <!-- Save History -->
                    <LinearLayout
                        style="@style/SettingsItem">
                        <ImageView
                            style="@style/SettingsItemIcon"
                            android:src="@drawable/ic_history" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/SettingsItemText"
                                android:layout_width="match_parent"
                                android:layout_weight="0"
                                android:text="Save scans to history" />
                            <TextView
                                style="@style/SettingsItemDescription"
                                android:text="Automatically record solutions in Lab History" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchSaveHistory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SCANNER ACCURACY TIP -->
            <com.google.android.material.card.MaterialCardView
                style="@style/SettingsCard"
                app:cardBackgroundColor="#EFF6FF"
                app:strokeColor="#BFDBFE">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_bolt"
                        app:tint="@color/sapphire_primary"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tip: Enable Grid Lines to frame math equations squarely for optimal OCR accuracy."
                        android:textColor="@color/sapphire_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
