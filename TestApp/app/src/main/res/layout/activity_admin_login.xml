<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adminLoginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_admin_hero_banner"
    tools:context=".AdminLoginActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#22000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/adminLoginContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Executive Identity Header -->
            <FrameLayout
                android:id="@+id/adminHeaderIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAdminLoginProfile"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@color/sapphire_primary_dark"
                    android:padding="3dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_app_logo"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="3dp" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_icon_container_emerald"
                    android:elevation="4dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_verified_check"
                    app:tint="@color/emerald_accent" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvAdminTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:letterSpacing="0.02"
                android:text="Administrative Portal"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdminSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.05"
                android:text="AUTHORIZED PRIVILEGED ACCESS ONLY"
                android:textColor="@color/sky_400"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Login Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/adminLoginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign In to Console"
                        android:textColor="@color/text_primary_slate"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="20dp"
                        android:text="Enter your institutional admin username or email"
                        android:textColor="@color/text_secondary_slate"
                        android:textSize="13sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAdminUser"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Admin Email or Username"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/sapphire_primary"
                        app:startIconDrawable="@drawable/ic_user_person"
                        app:startIconTint="@color/sapphire_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAdminUser"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/text_primary_slate"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAdminPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Administrative Password"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/sapphire_primary"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/sapphire_primary"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/sapphire_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAdminPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/text_primary_slate"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAdminLogin"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:letterSpacing="0.04"
                            android:text="SECURE LOGIN"
                            android:textColor="@android:color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/sapphire_primary"
                            app:cornerRadius="14dp"
                            app:elevation="3dp"
                            app:icon="@drawable/ic_lock"
                            app:iconGravity="textStart"
                            app:iconPadding="10dp"
                            app:iconSize="18dp"
                            app:iconTint="@android:color/white" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/adminLoginProgress"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@android:color/white"
                            app:trackThickness="3dp" />
                    </FrameLayout>

                    <!-- Social / SSO Divider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/card_stroke" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="12dp"
                            android:text="Or sign in with SSO"
                            android:textColor="@color/text_secondary_slate"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/card_stroke" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btnAdminGoogleLogin"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginHorizontal="8dp"
                            android:background="@drawable/bg_circle_light"
                            android:clickable="true"
                            android:contentDescription="Google SSO"
                            android:elevation="2dp"
                            android:focusable="true"
                            android:padding="10dp"
                            android:src="@drawable/ic_google_logo" />

                        <ImageView
                            android:id="@+id/btnAdminLinkedinLogin"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginHorizontal="8dp"
                            android:background="@drawable/bg_circle_light"
                            android:clickable="true"
                            android:contentDescription="LinkedIn SSO"
                            android:elevation="2dp"
                            android:focusable="true"
                            android:padding="10dp"
                            android:src="@drawable/ic_linkedin_logo" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAdminRegisterLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="20dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:text="New Administrator? Request Registration"
                        android:textColor="@color/sapphire_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>