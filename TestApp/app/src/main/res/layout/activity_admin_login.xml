<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adminLoginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_admin_mix"
    tools:context=".AdminLoginActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#11000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/adminLoginContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center_vertical">

            <!-- 🛡 Admin Identity Header -->
            <FrameLayout
                android:id="@+id/adminHeaderIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAdminLoginProfile"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_app_logo"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="3dp"
                    android:background="#312E81"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="4dp"
                    android:src="@android:drawable/ic_lock_lock"
                    android:background="@drawable/bg_circle_light"
                    android:backgroundTint="#FFFFFF"
                    android:padding="5dp"
                    app:tint="#312E81"
                    android:elevation="4dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvAdminTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Admin Portal"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdminSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Authorized Personnel Only"
                android:textColor="#BDBDBD"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/adminLoginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_admin_card"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAdminUser"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Admin Email / Username"
                        android:textColorHint="#64748B"
                        app:hintTextColor="#312E81"
                        app:startIconDrawable="@android:drawable/ic_menu_edit"
                        app:startIconTint="#312E81"
                        app:boxStrokeColor="#312E81"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAdminUser"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="#1E1B4B"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAdminPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Password"
                        android:textColorHint="#64748B"
                        app:hintTextColor="#312E81"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#312E81"
                        app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                        app:startIconTint="#312E81"
                        app:boxStrokeColor="#312E81"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAdminPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="#1E1B4B"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAdminLogin"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:text="SECURE LOGIN"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:letterSpacing="0.05"
                            app:backgroundTint="#312E81"
                            app:cornerRadius="12dp"
                            app:elevation="4dp" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/adminLoginProgress"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@android:color/white"
                            app:trackThickness="3dp" />
                    </FrameLayout>

                    <!-- Social Login Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="16dp">
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#33312E81"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Or continue with" android:textColor="#64748B" android:layout_marginHorizontal="10dp" android:textSize="12sp"/>
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#33312E81"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <ImageView
                            android:id="@+id/btnAdminGoogleLogin"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="8dp"
                            android:layout_marginHorizontal="10dp"
                            android:src="@drawable/ic_google_logo"
                            android:background="@drawable/bg_circle_light"
                            android:elevation="2dp"
                            android:clickable="true"
                            android:focusable="true"/>
                        <ImageView
                            android:id="@+id/btnAdminLinkedinLogin"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="8dp"
                            android:layout_marginHorizontal="10dp"
                            android:src="@drawable/ic_linkedin_logo"
                            android:background="@drawable/bg_circle_light"
                            android:elevation="2dp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAdminRegisterLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="24dp"
                        android:text="New Admin? Request Registration"
                        android:textColor="#312E81"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>