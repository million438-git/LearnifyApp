<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nature_gradient"
    tools:context=".StudentLoginActivity">

    <!-- Decorative background elements -->
    <View
        android:layout_width="550dp"
        android:layout_height="550dp"
        android:layout_marginStart="-150dp"
        android:layout_marginTop="-150dp"
        android:alpha="0.15"
        android:background="@android:drawable/screen_background_dark_transparent"
        android:backgroundTint="#B39DDB"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Main Login Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/loginCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="@color/text_primary"
        app:cardCornerRadius="30dp"
        app:cardElevation="20dp"
        app:layout_constraintWidth_max="550dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/loginFormContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvLoginHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:fontFamily="sans-serif-medium"
                android:text="Welcome Back"
                android:textColor="#1323C2"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLoginSubHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Student Portal Login"
                android:textColor="#0B853D"
                android:textSize="16sp" />

            <!-- Username Group -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/labelUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="start"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="#F8F9FA"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:strokeColor="#2962FF"
                app:strokeWidth="1.5dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    android:text="Username or Email"
                    android:textColor="#3F51B5"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStudentUser"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxBackgroundColor="#2564A2"
                app:boxCornerRadiusBottomEnd="30dp"
                app:boxCornerRadiusBottomStart="30dp"
                app:boxCornerRadiusTopEnd="30dp"
                app:boxCornerRadiusTopStart="30dp"
                app:boxStrokeColor="#2962FF"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                app:startIconTint="#FFD600"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStudentUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter your username"
                    android:inputType="textEmailAddress"
                    android:padding="20dp"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:background="@drawable/bg_vibrant_sidebar"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Group -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/labelPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_gravity="start"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="#F2F3F4"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:strokeColor="#2962FF"
                app:strokeWidth="1.5dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    android:text="Password"
                    android:textColor="#3F51B5"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStudentPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxBackgroundColor="#F8F9FA"
                app:boxCornerRadiusBottomEnd="30dp"
                app:boxCornerRadiusBottomStart="30dp"
                app:boxCornerRadiusTopEnd="30dp"
                app:boxCornerRadiusTopStart="30dp"
                app:boxStrokeColor="#2962FF"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="password_toggle"
                app:endIconTint="#FFD600"
                app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                app:startIconTint="#0D143D"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStudentPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter your password"
                    android:inputType="textPassword"
                    android:padding="20dp"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:background="@drawable/bg_vibrant_sidebar"/>
            </com.google.android.material.textfield.TextInputLayout>

            <RelativeLayout
                android:id="@+id/optionsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="8dp">

                <CheckBox
                    android:id="@+id/cbRememberMe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#2962FF"
                    android:text="Remember Me"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Forgot Password?"
                    android:textColor="#2962FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Main Login Button Container for Spinner Overlay -->
            <FrameLayout
                android:id="@+id/loginButtonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStudentLogin"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_login_button"
                    app:backgroundTint="@null"
                    android:text="Sign In Now"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="30dp"
                    app:elevation="8dp" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/loginProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@android:color/white"
                    app:trackThickness="3dp" />
            </FrameLayout>

            <!-- Signup Redirect -->
            <LinearLayout
                android:id="@+id/signupRedirectContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New student? "
                    android:textColor="#757575"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvRegisterRedirect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Account"
                    android:textColor="#2962FF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Circular Profile Header -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/loginProfileIcon"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginBottom="-55dp"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_camera"
        android:background="@color/ic_launcher_background"
        app:layout_constraintBottom_toTopOf="@+id/loginCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:strokeColor="@android:color/white"
        app:strokeWidth="5dp"
        android:elevation="21dp" />

</androidx.constraintlayout.widget.ConstraintLayout>