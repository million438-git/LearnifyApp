<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E5E7EB"
    tools:context=".CertificateActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/certificateToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1E293B"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@android:color/white"
            app:title="Certificate View"
            app:titleTextColor="@android:color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btnShare"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- FITS MOBILE SCREEN WIDTH PERFECTLY (Match Parent) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/certificateView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="0dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="404dp"
                    android:background="@drawable/bg_certificate_frame"
                    android:padding="20dp">

                    <!-- Top Branding (Compact for Mobile) -->
                    <LinearLayout
                        android:id="@+id/llHeaderBranding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_certificate_badge" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Learnify App"
                                android:textColor="#2D5A58"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="-2dp"
                                android:text="Certification Partner"
                                android:textColor="#2D5A58"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Main Title -->
                    <TextView
                        android:id="@+id/tvCertTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/llHeaderBranding"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="16dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="CERTIFICATE OF ACHIEVEMENT"
                        android:textColor="#1E293B"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Presentation Text -->
                    <TextView
                        android:id="@+id/tvPresentationText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvCertTitle"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="8dp"
                        android:text="Presented with distinction to:"
                        android:textColor="#475569"
                        android:textSize="12sp" />

                    <!-- Student Name -->
                    <TextView
                        android:id="@+id/tvStudentName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvPresentationText"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="MILLION TESHOME"
                        android:textColor="#0D9488"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/vUnderline"
                        android:layout_width="200dp"
                        android:layout_height="1dp"
                        android:layout_below="@id/tvStudentName"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="2dp"
                        android:background="#E2E8F0" />

                    <!-- Body Description -->
                    <TextView
                        android:id="@+id/tvBodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/vUnderline"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:paddingHorizontal="16dp"
                        android:text="For the successful completion and comprehensive mastery of the specified course(s) and curriculum requirements within the Learnify platform."
                        android:textColor="#475569"
                        android:textSize="11sp" />

                    <!-- Course Info List -->
                    <LinearLayout
                        android:id="@+id/llMetaInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvBodyText"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Course(s): "
                                android:textColor="#1E293B"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSubjectMastered"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mathematics 101"
                                android:textColor="#475569"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Date of Issue: "
                                android:textColor="#1E293B"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCertificateDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="20/05/2024"
                                android:textColor="#475569"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Student ID: "
                                android:textColor="#1E293B"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStudentID"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ID-12345"
                                android:textColor="#475569"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- RESPONSIVE NON-OVERLAPPING BOTTOM ROW -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/llMetaInfo"
                        android:layout_marginTop="20dp"
                        android:baselineAligned="false"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <!-- Signature Section (Left) -->
                        <LinearLayout
                            android:id="@+id/llSignArea"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="100dp"
                                android:layout_height="24dp"
                                android:alpha="0.1"
                                android:src="@drawable/ic_certificate_badge"
                                app:tint="#1E293B" />

                            <TextView
                                android:id="@+id/tvDirectorName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dr. Million Teshome"
                                android:textColor="#1E293B"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDirectorRole"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Certification Director"
                                android:textColor="#64748B"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <!-- Seal (Center) -->
                        <RelativeLayout
                            android:id="@+id/rlSeal"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_marginHorizontal="8dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/circle_bg"
                                android:padding="2dp"
                                android:src="@android:drawable/btn_star_big_on"
                                app:tint="#2D5A58" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:gravity="center"
                                android:text="Lfy\n2026"
                                android:textColor="#FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- ID Box (Right) -->
                        <LinearLayout
                            android:id="@+id/llIdBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:background="#E8DBB3"
                            android:gravity="end"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CERTIFICATE ID:"
                                android:textColor="#1E293B"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCertificateID"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LNYF-ABCD-1234"
                                android:textColor="#475569"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Student Verification"
                                android:textColor="#94A3B8"
                                android:textSize="7sp" />
                        </LinearLayout>

                    </LinearLayout>

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShare"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="16dp"
        android:text="Export Professional Certificate"
        android:textStyle="bold"
        android:backgroundTint="#0D9488"
        app:cornerRadius="8dp"
        app:icon="@android:drawable/ic_menu_save"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>