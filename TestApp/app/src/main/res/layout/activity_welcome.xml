<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    tools:context=".WelcomeActivity">

    <!-- Glowing Background Accents -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginTop="-100dp"
        android:layout_marginEnd="-100dp"
        android:alpha="0.3"
        android:background="@android:drawable/screen_background_dark_transparent"
        android:backgroundTint="#3B82F6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginBottom="-50dp"
        android:layout_marginStart="-50dp"
        android:alpha="0.2"
        android:background="@android:drawable/screen_background_dark_transparent"
        android:backgroundTint="#8B5CF6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Top Illustration/Image Area -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="240dp"
            android:layout_height="240dp"
            app:cardBackgroundColor="#111827"
            app:cardCornerRadius="40dp"
            app:cardElevation="0dp"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:src="@drawable/stdlogo"
                android:scaleType="fitCenter" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Simple Understanding Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Learn Smarter,\nNot Harder"
            android:textColor="@android:color/white"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:lineSpacingMultiplier="1.1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Study lessons, practice questions, and get AI help anytime."
            android:textColor="#94A3B8"
            android:textSize="17sp"
            android:textAlignment="center"
            android:paddingHorizontal="16dp"
            android:lineSpacingExtra="4dp" />

        <!-- Main Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="64dp"
            android:text="Get Started"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#2563EB"
            app:cornerRadius="32dp"
            app:elevation="8dp" />

        <!-- Footer Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Designed for students • Simple • Smart"
            android:textColor="#475569"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.05" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>