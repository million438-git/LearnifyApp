<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootWelcomeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onb_slide1_start"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".WelcomeActivity">

    <!-- 1. Full-Bleed Dynamic Background Gradient View -->
    <View
        android:id="@+id/vBackgroundGradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Soft Translucent Floating Background Orbs -->
    <ImageView
        android:id="@+id/ivOrb1"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_marginStart="-40dp"
        android:layout_marginTop="30dp"
        android:contentDescription="@null"
        android:src="@drawable/bg_onb_orb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivOrb2"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginEnd="-60dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="@null"
        android:src="@drawable/bg_onb_orb"
        app:layout_constraintBottom_toTopOf="@id/guidelineWelcomeSheet"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Guideline dividing top gradient hero (~56%) and bottom white sheet (~44%) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineWelcomeSheet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.56" />

    <!-- 3. Static White Sheet with 32dp Rounded Top Corners -->
    <View
        android:id="@+id/vWhiteSheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_onb_sheet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guidelineWelcomeSheet" />

    <!-- 4. Interactive Swipeable ViewPager2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 5. Fixed Brand Header (Top Bar with Safe Status-Bar Inset Padding) -->
    <RelativeLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo & Wordmark Group -->
        <LinearLayout
            android:id="@+id/brandIdentityGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Rounded-Square White Logo Badge -->
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_onb_logo_badge">

                <ImageView
                    android:id="@+id/ivHeaderLogoBook"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Learnify Logo"
                    android:src="@drawable/ic_onb_logo_book" />
            </FrameLayout>

            <!-- Learnify Wordmark: White, Black Weight -->
            <TextView
                android:id="@+id/tvBrandWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="Learnify"
                android:textColor="@color/white"
                android:textSize="21sp" />
        </LinearLayout>

        <!-- Portals Pill Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPortalHubTop"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_onb_portal_btn"
            android:fontFamily="sans-serif-medium"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="0dp"
            android:text="Portals"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:cornerRadius="18dp" />
    </RelativeLayout>

    <!-- 6. Fixed Bottom Controls Sheet Container -->
    <LinearLayout
        android:id="@+id/llControlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Controls Row 1: Dots on left, Skip on right -->
        <RelativeLayout
            android:id="@+id/rlIndicatorRow"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical">

            <!-- Animated Page Dots Container -->
            <LinearLayout
                android:id="@+id/llDotsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 4 Dot Views (Dynamically animated in code) -->
                <View
                    android:id="@+id/dot0"
                    android:layout_width="24dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_onb_dot_inactive" />

                <View
                    android:id="@+id/dot1"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_onb_dot_inactive" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_onb_dot_inactive" />

                <View
                    android:id="@+id/dot3"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_onb_dot_inactive" />
            </LinearLayout>

            <!-- Skip Button: Fades out and disabled on last slide -->
            <TextView
                android:id="@+id/tvSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:text="Skip"
                android:textColor="@color/onb_text_description"
                android:textSize="14sp" />
        </RelativeLayout>

        <!-- Controls Row 2: Dynamic Main Action Button (Next / Get Started) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:elevation="4dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.02"
            android:stateListAnimator="@null"
            android:text="Next"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:rippleColor="#40FFFFFF" />

        <!-- Controls Row 3: Sign In Redirect Prompt -->
        <TextView
            android:id="@+id/btnSignIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="@color/onb_text_description"
            android:textSize="14sp"
            tools:text="Already have an account?  Sign In" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
