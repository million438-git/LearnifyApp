<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include the main user database -->
        <include domain="database" path="AceGradeProfessional.db"/>
        <!-- Include all shared preferences (Sessions, Login, Settings) -->
        <include domain="sharedpref" path="."/>
        <!-- PROFESSIONAL FIX: Include internal files for cloud restoration -->
        <include domain="file" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="AceGradeProfessional.db"/>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>